<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.2</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-spring-cloud-parent</artifactId>
    <version>4.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>uetlib-spring-cloud-parent</name>
    <description>Spring Cloud integrations for uetlib applications.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-spring-cloud</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <properties>
        <sonar.projectName>uetlib-spring-cloud</sonar.projectName>
        <sonar.coverage.module>uetlib-spring-cloud-coverage</sonar.coverage.module>
    </properties>

    <modules>
        <module>uetlib-spring-cloud</module>
        <module>uetlib-spring-cloud-security</module>
        <module>uetlib-spring-cloud-coverage</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>4.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot-security</artifactId>
                <version>4.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot-test</artifactId>
                <version>3.0.1</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>



    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-spring-cloud.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-spring-cloud.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-spring-cloud</url>
    </scm>
</project>
